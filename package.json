{
  "name": "evergreen-insurance",
  "private": true,
  "workspaces": ["packages/*", "services/*", "tests/*"],
  "scripts": {
    "db:generate": "for s in services/*; do (cd \"$s\" && bunx prisma generate); done",
    "reset": "bash scripts/reset-all.sh",
    "seed": "bash scripts/reset-all.sh",
    "showcase": "bun run scripts/run-showcase.ts",
    "showcase:check": "bun run scripts/run-showcase.ts --check"
  },
  "devDependencies": {
    "@types/bun": "^1.2.4",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "@prisma/adapter-libsql": "^7.8.0",
    "yaml": "^2.8.3"
  }
}
